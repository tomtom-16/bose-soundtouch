<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.example.boseradio</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/path/to/bose-soundtouch/bose_radio.py</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/path/to/bose-soundtouch/proxy.log</string>
    <key>StandardErrorPath</key><string>/path/to/bose-soundtouch/proxy.log</string>
    <key>WorkingDirectory</key><string>/path/to/bose-soundtouch</string>
</dict>
</plist>
